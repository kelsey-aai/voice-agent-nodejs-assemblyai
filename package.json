{
  "name": "voice-agent-nodejs-assemblyai",
  "version": "1.0.0",
  "description": "Node.js voice agent using AssemblyAI STT 3.7 Realtime Agent for real-time speech-to-text and AssemblyAI Text-to-Speech for the agent's voice",
  "main": "src/agent.js",
  "type": "module",
  "scripts": {
    "start": "node src/agent.js",
    "server": "node src/server.js",
    "dev:agent": "node --watch src/agent.js",
    "dev:server": "node --watch src/server.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "assemblyai": "^4.43.1",
    "dotenv": "^16.4.5",
    "mic": "^2.1.2",
    "openai": "^4.52.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "assemblyai",
    "voice-agent",
    "speech-to-text",
    "assemblyai-stt-3-7-realtime-agent",
    "websocket",
    "openai",
    "text-to-speech",
    "real-time"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
